# SERVER-SIDE ONLY. Never prefix these with VITE_.
# Neon dashboard -> your project -> Connect -> copy the connection string
# (the "pooled" one is fine). It contains the database password.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Optional extra protection: if set, every API call must send this key
# (enter it once in Settings > Access key). Use a long random string.
APP_ACCESS_KEY=
